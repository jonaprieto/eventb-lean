m_guards5&quot; predicate=&quot;Next_VSS[vss_set∖{front}]= vss_set∖{rear}&quot;/&gt;&#10;      &lt;guards comment=&quot;&quot; name=&quot;cdm_guards6&quot; predicate=&quot;Next_VSS∼[vss_set∖{rear}]= vss_set∖{front}&quot;/&gt;&#10;      &lt;guards comment=&quot;&quot; name=&quot;cdm_guards11&quot; predicate=&quot;Next_VSS[vss_set0∖{front0}]= vss_set0∖{rear0}&quot;/&gt;&#10;      &lt;guards comment=&quot;&quot; name=&quot;cdm_guards12&quot; predicate=&quot;Next_VSS∼[vss_set0∖{rear0}]= vss_set0∖{front0}&quot;/&gt;&#10;      &lt;guards comment=&quot;&quot; name=&quot;cdm_guards13&quot; predicate=&quot;Next_VSS[(vss_set ∩ vss_set0)∖{rear0}]= (vss_set ∩ vss_set0)∖{front}&quot;/&gt;&#10;      &lt;guards comment=&quot;&quot; name=&quot;cdm_guards14&quot; predicate=&quot;Next_VSS∼[(vss_set ∩ vss_set0)∖{front}]= (vss_set ∩ vss_set0)∖{rear0}&quot;/&gt;&#10;      &lt;actions comment=&quot;&quot; name=&quot;cdm_actions5&quot; action=&quot;occupiedBy ≔ (occupiedBy ⩥ {tr0}) ∪ (vss_set0× {tr0}) ∪ (vss_set × {tr})&quot;/&gt;&#10;      &lt;actions comment=&quot;&quot; name=&quot;cdm_actions6&quot; action=&quot;ghost ≔ ghost ∪ {tr}&quot;/&gt;&#10;    &lt;/methods&gt;&#10;    &lt;methods internalId=&quot;_REXesAHdEeiYuL1vM5OOOw&quot; comment=&quot;&quot;&gt;&#10;      &lt;elaborates href=&quot;platform:/resource/HL3/VBD_M5.bum#http://emf.eventb.org/models/core/machine/2014::Event::VBD_M5.ENV_leave_network_and_free_ttd&quot;/&gt;&#10;    &lt;/methods&gt;&#10;  &lt;/classes&gt;&#10;  &lt;classes name=&quot;VSS&quot; selfName=&quot;vss&quot;&gt;&#10;    &lt;elaborates xsi:type=&quot;context:CarrierSet&quot; href=&quot;platform:/resource/HL3/Env_C0.buc#http://emf.eventb.org/models/core/context/2014::CarrierSet::Env_C0.VSS&quot;/&gt;&#10;    &lt;classAttributes comment=&quot;&quot; name=&quot;disconnectPropagationTimerExpired&quot; total=&quot;true&quot; functional=&quot;true&quot; target=&quot;BOOL&quot;&gt;&#10;      &lt;elaborates xsi:type=&quot;machine:Variable&quot; href=&quot;platform